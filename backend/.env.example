# Is file ko copy karke ".env" naam se save karein aur apni values likhein
# (.env ko kabhi GitHub par push na karein)

PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=appointment_system

# JWT (koi lamba random string rakhein)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# React frontend ka address (CORS ke liye)
CLIENT_URL=http://localhost:3000

# Pehla admin banane ke liye (npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
